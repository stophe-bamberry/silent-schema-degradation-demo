{
  "name": "silent-schema-degradation-demo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \".github/workflows/*.yml\" README.md \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \".github/workflows/*.yml\" README.md \"*.json\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:demos": "tsc",
    "demo:incident": "npm run build:demos && node dist/src/demos/incident.js",
    "demo:reconciliation": "npm run build:demos && node dist/src/demos/reconciliation.js",
    "demo:validation": "npm run build:demos && node dist/src/demos/validation.js",
    "demo:forward-fix": "npm run build:demos && node dist/src/demos/forward-fix.js",
    "demo:recovery": "npm run build:demos && node dist/src/demos/recovery.js",
    "demo:all": "npm run build:demos && node dist/src/demos/incident.js && node dist/src/demos/reconciliation.js && node dist/src/demos/validation.js && node dist/src/demos/forward-fix.js && node dist/src/demos/recovery.js"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
